&НаКлиентеПроцедура ВыполнитьЗадания21_23()    // Задание 2.1    ФИО = "Трухина Анастасия Александровна";    ЧастиФИО = СтрРазделить(ФИО, " ");    КраткоеФИО = ЧастиФИО[0]        + " " + Лев(ЧастиФИО[1], 1) + "."        + Лев(ЧастиФИО[2], 1) + ".";    Сообщить(СтрШаблон("%1 = %2", ФИО, КраткоеФИО));    
	
	    // Задание 2.2    СебестоимостьТовара = 100;    Наценка = 40;    СтавкаНДС = 20;    ЦенаСНаценкой = СебестоимостьТовара        * (1 + Наценка / 100);    ИтоговаяЦена = ЦенаСНаценкой        * (1 + СтавкаНДС / 100);    Сообщить(        СтрШаблон(            "Итоговая цена товара для розничного покупателя: %1",            ИтоговаяЦена        )    );
	
	// Задание 2.3	ЗагаданноеЧисло = 500;	ВыбранноеЧисло = 495;	Если ЗагаданноеЧисло < 0	    Или ЗагаданноеЧисло > 1000 Тогда	    Сообщить("Первый игрок проиграл!");	ИначеЕсли ВыбранноеЧисло >= ЗагаданноеЧисло - 10	    И ВыбранноеЧисло <= ЗагаданноеЧисло + 10 Тогда	    Сообщить("Второй игрок победил!");	Иначе	    Сообщить("Первый игрок победил!");	КонецЕсли;           
КонецПроцедуры     

                